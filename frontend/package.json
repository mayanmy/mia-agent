{
  "name": "mia-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:widget && tsc -b && vite build",
    "build:widget": "node scripts/build-widget.mjs",
    "preview": "vite preview",
