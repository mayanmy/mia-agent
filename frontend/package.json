  },
  "dependencies": {
    "antd": "^6.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "less": "^4.6.7",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
