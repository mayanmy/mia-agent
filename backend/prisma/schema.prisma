generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModelProviderType {
  OPENAI_COMPATIBLE @map("openai_compatible")
  OLLAMA            @map("ollama")
  ANTHROPIC         @map("anthropic")
  GEMINI            @map("gemini")

  @@map("model_provider_type")
}

enum ModelConfigType {
  CHAT      @map("chat")
  EMBEDDING @map("embedding")

  @@map("model_config_type")
}

/// Chat 模型的思考模式；AUTO 不向供应商发送覆盖参数，保持原有兼容行为。
enum ModelThinkingMode {
  AUTO     @map("auto")
  ENABLED  @map("enabled")
  DISABLED @map("disabled")

  @@map("model_thinking_mode")
}

enum ModelCapabilityType {
  TEXT_CHAT
  VISION_INPUT
  TOOL_CALLING
  REASONING
  STRUCTURED_OUTPUT
  AUDIO_INPUT
  AUDIO_OUTPUT
  IMAGE_GENERATION
  EMBEDDING
  RERANK

  @@map("model_capability_type")
}

enum AgentVisionMode {
  AUTO
  PRIMARY_ONLY
  DEDICATED
  DISABLED

  @@map("agent_vision_mode")
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

/// 项目空间内的授权角色；用户身份全局唯一，但权限随项目空间成员关系变化。
enum WorkspaceRole {
  OWNER
  MANAGER
  MEMBER

  @@map("workspace_role")
}

/// Agent 对话的会话生命周期。
///
/// EPHEMERAL 保持测试对话的即时性；PERSISTENT 才会为每个成员保存可恢复的会话记录，
/// 避免默认保存所有调试消息造成无意义的数据累积。
enum AgentChatSessionMode {
  EPHEMERAL
  PERSISTENT

  @@map("agent_chat_session_mode")
}

/// Agent 可以继续使用自主 Tool Loop，也可以绑定已发布 Workflow 进行确定性编排。
enum AgentExecutionMode {
  AGENT_LOOP
  WORKFLOW

  @@map("agent_execution_mode")
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("workflow_status")
}

enum WorkflowRunMode {
  DRAFT_TEST
  PUBLISHED

  @@map("workflow_run_mode")
}

enum ChatSessionMessageRole {
  USER
  ASSISTANT

  @@map("chat_session_message_role")
}

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED

  @@map("chat_session_status")
}

enum ChatMessageFeedbackRating {
  UP
  DOWN

  @@map("chat_message_feedback_rating")
}

/// 外部访问入口决定 End User 与会话的隔离范围，不能只用一个字符串标识混合公开访客和业务用户。
enum ExternalUserSource {
  WIDGET
  WEBAPP
  SERVICE_API

  @@map("external_user_source")
}

/// 一次 Agent Run 的调用入口，用于区分内部成员、公开访客和业务系统请求。
enum AgentRunSource {
  INTERNAL_CHAT
  PUBLIC_WIDGET
  SERVICE_API
  ASYNC_TASK
  WORKFLOW_APP

  @@map("agent_run_source")
}

/// Agent Run 只允许从排队态进入运行态，再收敛到唯一终态。
enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELED
  TIMED_OUT

  @@map("agent_run_status")
}

/// Step 类型覆盖当前检索、模型和工具调用，并为后续 Hook、Subagent 保留稳定值。
enum AgentRunStepType {
  ROUTER
  TOOL_SEARCH
  RETRIEVAL
  MODEL
  TOOL
  WORKFLOW
  CONDITION
  TRANSFORM
  HOOK
  SUBAGENT

  @@map("agent_run_step_type")
}

enum AgentRunStepStatus {
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELED
  SKIPPED

  @@map("agent_run_step_status")
}

/// Mia 首期只接入可远程部署且适合本地服务治理的 Streamable HTTP transport。
enum McpTransport {
  STREAMABLE_HTTP

  @@map("mcp_transport")
}

enum McpAuthType {
  NONE
  BEARER
  API_KEY_HEADER
  CLIENT_CREDENTIALS
  OAUTH

  @@map("mcp_auth_type")
}

enum McpApprovalMode {
  AUTO
  CONFIRM
  DISABLED

  @@map("mcp_approval_mode")
}

enum McpToolApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CONSUMED
  EXPIRED
  CANCELED

  @@map("mcp_tool_approval_status")
}

enum McpHealthStatus {
  UNKNOWN
  CONNECTING
  HEALTHY
  DEGRADED
  UNAVAILABLE
  AUTH_REQUIRED

  @@map("mcp_health_status")
}

enum McpRiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("mcp_risk_level")
}

enum McpSyncStatus {
  RUNNING
  COMPLETED
  FAILED

  @@map("mcp_sync_status")
}

enum McpSyncTrigger {
  CREATE
  MANUAL
  TEST
  NOTIFICATION
  SCHEDULED

  @@map("mcp_sync_trigger")
}

model User {
  id                            String                  @id @default(uuid()) @db.Uuid
  email                         String                  @unique(map: "uq_users_email")
  displayName                   String                  @map("display_name")
  passwordHash                  String                  @map("password_hash")
  role                          UserRole                @default(USER)
  lastLoginAt                   DateTime?               @map("last_login_at") @db.Timestamptz(6)
  disabledAt                    DateTime?               @map("disabled_at") @db.Timestamptz(6)
  passwordChangedAt             DateTime                @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt                     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  authSessions                  AuthSession[]
  sentInvitations               UserInvitation[]        @relation("UserInvitationInviter")
  chatSessions                  ChatSession[]
  createdAgentApiKeys           AgentApiKey[]           @relation("AgentApiKeyCreator")
  createdAgents                 Agent[]                 @relation("AgentCreator")
  agentRuns                     AgentRun[]
  createdHttpTools              HttpTool[]              @relation("HttpToolCreator")
  createdToolSecrets            ToolSecret[]            @relation("ToolSecretCreator")
  createdMcpServers             McpServer[]             @relation("McpServerCreator")
  createdMcpSecrets             McpServerSecret[]       @relation("McpServerSecretCreator")
  createdMcpOAuthAuthorizations McpOAuthAuthorization[] @relation("McpOAuthAuthorizationCreator")
  mcpToolApprovals              McpToolApproval[]
  chatMessageFeedbacks          ChatMessageFeedback[]
  workspaceMemberships          WorkspaceMember[]
  createdWorkspaces             Workspace[]             @relation("WorkspaceCreator")

  @@index([role, disabledAt], map: "idx_users_role_disabled_at")
  @@index([createdAt(sort: Desc)], map: "idx_users_created_at")
  @@map("users")
}

/// 项目空间是 Mia 的一级数据和权限边界，同一用户可以加入多个空间。
model Workspace {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  description String            @default("") @db.Text
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdBy   User              @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  invitations UserInvitation[]

  @@index([deletedAt, createdAt(sort: Desc)], map: "idx_workspaces_deleted_created_at")
  @@index([createdById], map: "idx_workspaces_created_by_id")
  @@map("workspaces")
}

/// 用户在指定项目空间内的有效成员关系；removedAt 非空后立即失去空间访问权。
model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)
  removedAt   DateTime?     @map("removed_at") @db.Timestamptz(6)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId, removedAt], map: "idx_workspace_members_user_removed_at")
  @@index([workspaceId, role, removedAt], map: "idx_workspace_members_workspace_role_removed_at")
  @@map("workspace_members")
}

/**
 * 管理员发出的成员激活邀请。
 * 邀请阶段不预创建 User：只有持有有效链接的成员设置密码后才创建账号，因而 users 表内
 * 的记录始终都是可登录的正式成员，避免引入额外的“待激活用户”状态分支。
 */
model UserInvitation {
  id              String        @id @default(uuid()) @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  email           String
  displayName     String        @map("display_name")
  role            WorkspaceRole @default(MEMBER)
  tokenHash       String        @unique(map: "uq_user_invitations_token_hash") @map("token_hash")
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?     @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  invitedByUserId String        @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  invitedBy       User          @relation("UserInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email], map: "uq_user_invitations_workspace_email")
  @@index([expiresAt], map: "idx_user_invitations_expires_at")
  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_user_invitations_workspace_created_at")
  @@index([invitedByUserId, createdAt(sort: Desc)], map: "idx_user_invitations_invited_by_created_at")
  @@map("user_invitations")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "uq_auth_sessions_refresh_token_hash") @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)], map: "idx_auth_sessions_user_id_expires_at")
  @@index([expiresAt], map: "idx_auth_sessions_expires_at")
  @@map("auth_sessions")
}

model ModelProvider {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @map("workspace_id") @db.Uuid
  name            String
  providerType    ModelProviderType @map("provider_type")
  baseUrl         String            @map("base_url")
  apiKeyEncrypted String?           @map("api_key_encrypted")
  enabled         Boolean           @default(true)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  modelConfigs    ModelConfig[]

  @@index([createdAt(sort: Desc)], map: "idx_model_providers_created_at")
  @@index([enabled, createdAt(sort: Desc)], map: "idx_model_providers_enabled_created_at")
  @@map("model_providers")
}

model ModelConfig {
  id                       String                   @id @default(uuid()) @db.Uuid
  workspaceId              String                   @map("workspace_id") @db.Uuid
  providerId               String                   @map("provider_id") @db.Uuid
  modelName                String                   @map("model_name")
  modelType                ModelConfigType          @map("model_type")
  credentialName           String                   @default("") @map("credential_name")
  contextLength            Int                      @default(4096) @map("context_length")
  embeddingDimension       Int?                     @map("embedding_dimension")
  enabled                  Boolean                  @default(true)
  timeoutSeconds           Int                      @default(120) @map("timeout_seconds")
  maxTokens                Int?                     @map("max_tokens")
  thinkingMode             ModelThinkingMode        @default(AUTO) @map("thinking_mode")
  /// 是否支持由调用方显式开启/关闭思考；不支持时 Agent 不得覆盖模型默认行为。
  thinkingSupported        Boolean                  @default(false) @map("thinking_supported")
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                @map("deleted_at") @db.Timestamptz(6)
  provider                 ModelProvider            @relation(fields: [providerId], references: [id])
  agents                   Agent[]
  knowledgeBases           KnowledgeBase[]
  knowledgeEmbeddings      KnowledgeEmbedding[]
  knowledgeEmbeddings1024  KnowledgeEmbedding1024[]
  knowledgeEmbeddings1536  KnowledgeEmbedding1536[]
  knowledgeEmbeddings3072  KnowledgeEmbedding3072[]
  defaultChatSettings      DefaultModelSetting[]    @relation("DefaultChatModel")
  defaultEmbeddingSettings DefaultModelSetting[]    @relation("DefaultEmbeddingModel")
  defaultVisionSettings    DefaultModelSetting[]    @relation("DefaultVisionModel")
  capabilities             ModelCapability[]
  visionAgents             Agent[]                  @relation("AgentVisionModel")

  @@index([providerId], map: "idx_model_configs_provider_id")
  @@index([modelType, enabled], map: "idx_model_configs_type_enabled")
  @@index([createdAt(sort: Desc)], map: "idx_model_configs_created_at")
  @@map("model_configs")
}

model ModelCapability {
  id            String              @id @default(uuid()) @db.Uuid
  modelConfigId String              @map("model_config_id") @db.Uuid
  capability    ModelCapabilityType
  enabled       Boolean             @default(true)
  options       Json?               @db.JsonB
  verified      Boolean             @default(false)
  verifiedAt    DateTime?           @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  modelConfig   ModelConfig          @relation(fields: [modelConfigId], references: [id], onDelete: Cascade)

  @@unique([modelConfigId, capability])
  @@index([capability, enabled])
  @@map("model_capabilities")
}

model DefaultModelSetting {
  id                     String       @id
  workspaceId            String       @unique(map: "uq_default_model_settings_workspace_id") @map("workspace_id") @db.Uuid
  chatModelConfigId      String?      @map("chat_model_config_id") @db.Uuid
  embeddingModelConfigId String?      @map("embedding_model_config_id") @db.Uuid
  visionModelConfigId    String?      @map("vision_model_config_id") @db.Uuid
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  chatModelConfig        ModelConfig? @relation("DefaultChatModel", fields: [chatModelConfigId], references: [id], onDelete: SetNull)
  embeddingModelConfig   ModelConfig? @relation("DefaultEmbeddingModel", fields: [embeddingModelConfigId], references: [id], onDelete: SetNull)
  visionModelConfig      ModelConfig? @relation("DefaultVisionModel", fields: [visionModelConfigId], references: [id], onDelete: SetNull)

  @@index([chatModelConfigId], map: "idx_default_model_settings_chat_model_config_id")
  @@index([embeddingModelConfigId], map: "idx_default_model_settings_embedding_model_config_id")
  @@index([visionModelConfigId], map: "idx_default_model_settings_vision_model_config_id")
  @@map("default_model_settings")
}

model Agent {
  id                    String                 @id @default(uuid()) @db.Uuid
  workspaceId           String                 @map("workspace_id") @db.Uuid
  createdByUserId       String                 @map("created_by_user_id") @db.Uuid
  name                  String
  description           String                 @default("")
  systemPrompt          String                 @map("system_prompt") @db.Text
  modelConfigId         String                 @map("model_config_id") @db.Uuid
  visionMode            AgentVisionMode        @default(AUTO) @map("vision_mode")
  visionModelConfigId   String?                @map("vision_model_config_id") @db.Uuid
  temperature           Decimal                @default(0.70) @db.Decimal(3, 2)
  maxTokens             Int?                   @map("max_tokens")
  timeoutSeconds        Int                    @default(120) @map("timeout_seconds")
  historyTurns          Int                    @default(6) @map("history_turns")
  chatSessionMode       AgentChatSessionMode   @default(EPHEMERAL) @map("chat_session_mode")
  executionMode         AgentExecutionMode     @default(AGENT_LOOP) @map("execution_mode")
  generationParams      Json?                  @map("generation_params") @db.JsonB
  /// Agent 对模型默认思考模式的覆盖；AUTO 表示跟随模型配置。
  thinkingMode          ModelThinkingMode      @default(AUTO) @map("thinking_mode")
  enabled               Boolean                @default(true)
  published             Boolean                @default(false)
  publishedAt           DateTime?              @map("published_at") @db.Timestamptz(6)
  shareToken            String?                @unique(map: "uq_agents_share_token") @map("share_token")
  publicExpiresAt       DateTime?              @map("public_expires_at") @db.Timestamptz(6)
  publicAllowedOrigins  String[]               @default([]) @map("public_allowed_origins")
  publicPasswordHash    String?                @map("public_password_hash") @db.Text
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)
  modelConfig           ModelConfig            @relation(fields: [modelConfigId], references: [id])
  visionModelConfig     ModelConfig?           @relation("AgentVisionModel", fields: [visionModelConfigId], references: [id], onDelete: SetNull)
  createdBy             User                   @relation("AgentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  agentTools            AgentTool[]
  agentSkills           AgentSkill[]
  agentKnowledgeBases   AgentKnowledgeBase[]
  chatSessions          ChatSession[]
  apiKeys               AgentApiKey[]
  externalEndUsers      ExternalEndUser[]
  externalConversations ExternalConversation[]
  runs                  AgentRun[]
  agentWorkflow         AgentWorkflow?

  @@index([createdAt(sort: Desc)], map: "idx_agents_created_at")
  @@index([modelConfigId], map: "idx_agents_model_config_id")
  @@index([visionModelConfigId], map: "idx_agents_vision_model_config_id")
  @@index([enabled, createdAt(sort: Desc)], map: "idx_agents_enabled_created_at")
  @@index([published, publishedAt(sort: Desc)], map: "idx_agents_published_published_at")
  @@index([workspaceId, createdByUserId, deletedAt, createdAt(sort: Desc)], map: "idx_agents_workspace_creator_deleted_created")
  @@map("agents")
}

/// Agent 只绑定一个明确的已发布 Workflow Version；关系生命周期归 agents 模块管理。
model AgentWorkflow {
  agentId           String   @id @map("agent_id") @db.Uuid
  workflowId        String   @map("workflow_id") @db.Uuid
  workflowVersionId String   @map("workflow_version_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workflowId, workflowVersionId], map: "idx_agent_workflows_workflow_version")
  @@map("agent_workflows")
}

/// Workflow 保存可编辑草稿；正式执行只能引用 workflow_versions 中的不可变版本。
model Workflow {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @map("workspace_id") @db.Uuid
  name             String
  description      String            @default("") @db.Text
  status           WorkflowStatus    @default(DRAFT)
  draftGraph       Json              @map("draft_graph") @db.JsonB
  draftRevision    Int               @default(1) @map("draft_revision")
  publishedVersion Int?              @map("published_version")
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  versions         WorkflowVersion[]

  @@index([status, updatedAt(sort: Desc)], map: "idx_workflows_status_updated_at")
  @@index([createdByUserId, createdAt(sort: Desc)], map: "idx_workflows_creator_created_at")
  @@map("workflows")
}

/// 发布版本不可更新；graph 用于回显，compiled_plan 从 W2 开始由编译器生成。
model WorkflowVersion {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  workflowId         String   @map("workflow_id") @db.Uuid
  version            Int
  graphSchemaVersion Int      @map("graph_schema_version")
  graph              Json     @db.JsonB
  compiledPlan       Json     @map("compiled_plan") @db.JsonB
  checksum           String
  publishedByUserId  String   @map("published_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workflow           Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version], map: "uq_workflow_versions_workflow_version")
  @@index([workflowId, createdAt(sort: Desc)], map: "idx_workflow_versions_workflow_created_at")
  @@map("workflow_versions")
}

/// Skill 是管理员维护的可复用指令；MCP Prompt 导入只创建停用草稿，不自动注入 Agent。
model Skill {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  name            String
  description     String    @default("") @db.Text
  instructions    String    @db.Text
  usageConditions String    @default("") @map("usage_conditions") @db.Text
  inputGuidance   String    @default("") @map("input_guidance") @db.Text
  outputGuidance  String    @default("") @map("output_guidance") @db.Text
  limitations     String    @default("") @db.Text
  enabled         Boolean   @default(false)
  revision        Int       @default(1)
  sourceType      String    @default("manual") @map("source_type")
  sourceRef       Json?     @map("source_ref") @db.JsonB
  sourceHash      String?   @map("source_hash")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  agentSkills     AgentSkill[]

  @@index([enabled, updatedAt(sort: Desc)], map: "idx_skills_enabled_updated_at")
  @@index([createdByUserId], map: "idx_skills_created_by_user_id")
  @@index([sourceType, sourceHash], map: "idx_skills_source_hash")
  @@map("skills")
}

/// 业务后端调用 Agent 的长期凭证。原始 Key 只在创建或轮换时返回，数据库永远不保存明文。
model AgentApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  agentId     String    @map("agent_id") @db.Uuid
  name        String
  keyPrefix   String    @map("key_prefix")
  keyHash     String    @unique(map: "uq_agent_api_keys_key_hash") @map("key_hash")
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("AgentApiKeyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([agentId, createdAt(sort: Desc)], map: "idx_agent_api_keys_agent_id_created_at")
  @@index([expiresAt], map: "idx_agent_api_keys_expires_at")
  @@map("agent_api_keys")
}

/// 公开 Widget 与 Service API 的外部用户。externalId 仅用作隔离键，不是 Mia 工作台身份。
model ExternalEndUser {
  id            String                 @id @default(uuid()) @db.Uuid
  workspaceId   String                 @map("workspace_id") @db.Uuid
  agentId       String                 @map("agent_id") @db.Uuid
  source        ExternalUserSource
  externalId    String                 @map("external_id")
  firstSeenAt   DateTime               @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt    DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  agent         Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversations ExternalConversation[]

  @@unique([agentId, source, externalId], map: "uq_external_end_users_agent_source_external")
  @@index([agentId, lastSeenAt(sort: Desc)], map: "idx_external_end_users_agent_last_seen_at")
  @@map("external_end_users")
}

/// 外部调用的独立会话。它不能复用工作台 ChatSession，因为后者的 owner 固定为 Mia User UUID。
model ExternalConversation {
  id                String             @id @default(uuid()) @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  agentId           String             @map("agent_id") @db.Uuid
  externalEndUserId String             @map("external_end_user_id") @db.Uuid
  title             String?
  source            ExternalUserSource
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  externalEndUser   ExternalEndUser    @relation(fields: [externalEndUserId], references: [id], onDelete: Cascade)
  messages          ExternalMessage[]

  @@index([externalEndUserId, updatedAt(sort: Desc)], map: "idx_external_conversations_end_user_updated_at")
  @@index([agentId, createdAt(sort: Desc)], map: "idx_external_conversations_agent_created_at")
  @@map("external_conversations")
}

/// 外部会话首期只持久化文本与元数据；附件、工具和检索细节仍由已有日志模块承接。
model ExternalMessage {
  id             String               @id @default(uuid()) @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  role           String
  content        String               @db.Text
  metadata       Json?                @db.JsonB
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   ExternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt, id], map: "idx_external_messages_conversation_created_at")
  @@map("external_messages")
}

model AgentTool {
  agentId   String   @map("agent_id") @db.Uuid
  toolId    String   @map("tool_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, toolId])
  @@index([toolId], map: "idx_agent_tools_tool_id")
  @@map("agent_tools")
}

/// Agent 对 Skill 的有序绑定归 agents 模块管理；Skill 内容仍由 skills 模块拥有。
model AgentSkill {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  position  Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([agentId, skillId], map: "uq_agent_skills_agent_skill")
  @@unique([agentId, position], map: "uq_agent_skills_agent_position")
  @@index([skillId], map: "idx_agent_skills_skill_id")
  @@map("agent_skills")
}

/// 管理员预配置的 HTTP API 工具。运行时 ID 使用 `http_{id}`，继续兼容 AgentTool 的字符串绑定。
model HttpTool {
  id                  String      @id @default(uuid()) @db.Uuid
  workspaceId         String      @map("workspace_id") @db.Uuid
  name                String
  slug                String
  description         String      @db.Text
  enabled             Boolean     @default(true)
  method              String
  baseUrl             String      @map("base_url")
  path                String
  parameters          Json        @db.JsonB
  fixedHeaders        Json        @map("fixed_headers") @db.JsonB
  authType            String      @default("none") @map("auth_type")
  authHeaderName      String?     @map("auth_header_name")
  authConfig          Json        @default("{}") @map("auth_config") @db.JsonB
  secretId            String?     @unique(map: "uq_http_tools_secret_id") @map("secret_id") @db.Uuid
  timeoutMs           Int         @default(10000) @map("timeout_ms")
  maxResponseBytes    Int         @default(1000000) @map("max_response_bytes")
  allowPrivateNetwork Boolean     @default(false) @map("allow_private_network")
  createdByUserId     String      @map("created_by_user_id") @db.Uuid
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  secret              ToolSecret? @relation(fields: [secretId], references: [id], onDelete: SetNull)
  createdBy           User        @relation("HttpToolCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, slug], map: "uq_http_tools_workspace_slug")
  @@index([enabled, deletedAt], map: "idx_http_tools_enabled_deleted_at")
  @@index([createdAt(sort: Desc)], map: "idx_http_tools_created_at")
  @@index([workspaceId, createdByUserId, deletedAt, createdAt(sort: Desc)], map: "idx_http_tools_workspace_creator_deleted_created")
  @@map("http_tools")
}

/// HTTP Tool 的加密凭据。API 与日志只暴露 configured 状态，禁止返回密文。
model ToolSecret {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  name            String
  encryptedValue  String    @map("encrypted_value") @db.Text
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  httpTool        HttpTool?
  createdBy       User      @relation("ToolSecretCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([createdByUserId, createdAt(sort: Desc)], map: "idx_tool_secrets_creator_created_at")
  @@map("tool_secrets")
}

/// 管理员配置的 MCP Server。发现结果保存为本地快照，运行时不依赖实时 listTools。
model McpServer {
  id                        String                 @id @default(uuid()) @db.Uuid
  workspaceId               String                 @map("workspace_id") @db.Uuid
  name                      String
  slug                      String
  description               String                 @default("") @db.Text
  transport                 McpTransport           @default(STREAMABLE_HTTP)
  endpoint                  String
  authType                  McpAuthType            @default(NONE) @map("auth_type")
  authConfig                Json                   @default("{}") @map("auth_config") @db.JsonB
  secretId                  String?                @unique(map: "uq_mcp_servers_secret_id") @map("secret_id") @db.Uuid
  enabled                   Boolean                @default(true)
  allowPrivateNetwork       Boolean                @default(false) @map("allow_private_network")
  approvalMode              McpApprovalMode        @default(AUTO) @map("approval_mode")
  connectTimeoutMs          Int                    @default(10000) @map("connect_timeout_ms")
  toolTimeoutMs             Int                    @default(30000) @map("tool_timeout_ms")
  maxResponseBytes          Int                    @default(1000000) @map("max_response_bytes")
  maxOutputChars            Int                    @default(20000) @map("max_output_chars")
  maxConcurrency            Int                    @default(3) @map("max_concurrency")
  healthStatus              McpHealthStatus        @default(UNKNOWN) @map("health_status")
  negotiatedProtocolVersion String?                @map("negotiated_protocol_version")
  serverInfo                Json?                  @map("server_info") @db.JsonB
  capabilities              Json?                  @db.JsonB
  lastConnectedAt           DateTime?              @map("last_connected_at") @db.Timestamptz(6)
  lastDiscoveredAt          DateTime?              @map("last_discovered_at") @db.Timestamptz(6)
  lastErrorCode             String?                @map("last_error_code")
  lastErrorMessage          String?                @map("last_error_message") @db.Text
  createdByUserId           String                 @map("created_by_user_id") @db.Uuid
  deletedAt                 DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  secret                    McpServerSecret?       @relation(fields: [secretId], references: [id], onDelete: SetNull)
  createdBy                 User                   @relation("McpServerCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  tools                     McpServerTool[]
  syncRuns                  McpSyncRun[]
  oauthAuthorization        McpOAuthAuthorization?
  approvals                 McpToolApproval[]

  @@unique([workspaceId, slug], map: "uq_mcp_servers_workspace_slug")
  @@index([enabled, deletedAt], map: "idx_mcp_servers_enabled_deleted_at")
  @@index([healthStatus, updatedAt(sort: Desc)], map: "idx_mcp_servers_health_updated_at")
  @@map("mcp_servers")
}

/// MCP Server 的认证材料独立加密保存，任何查询 DTO 和日志都不得返回密文。
model McpServerSecret {
  id              String     @id @default(uuid()) @db.Uuid
  workspaceId     String     @map("workspace_id") @db.Uuid
  encryptedValue  String     @map("encrypted_value") @db.Text
  createdByUserId String     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  server          McpServer?
  createdBy       User       @relation("McpServerSecretCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([createdByUserId, createdAt(sort: Desc)], map: "idx_mcp_server_secrets_creator_created_at")
  @@map("mcp_server_secrets")
}

/// 团队共享的 MCP OAuth 授权。Token、PKCE 和 Discovery 状态整体加密，state 仅保存哈希。
model McpOAuthAuthorization {
  id              String    @id @default(uuid()) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  serverId        String    @unique(map: "uq_mcp_oauth_authorizations_server_id") @map("server_id") @db.Uuid
  encryptedState  String    @map("encrypted_state") @db.Text
  stateHash       String?   @unique(map: "uq_mcp_oauth_authorizations_state_hash") @map("state_hash")
  stateExpiresAt  DateTime? @map("state_expires_at") @db.Timestamptz(6)
  authorizedAt    DateTime? @map("authorized_at") @db.Timestamptz(6)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  server          McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("McpOAuthAuthorizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([stateExpiresAt], map: "idx_mcp_oauth_authorizations_state_expires_at")
  @@map("mcp_oauth_authorizations")
}

/// 远程 Tool 的本地发现快照。runtimeId 永久稳定，避免重同步破坏 Agent 已有绑定。
model McpServerTool {
  id                   String            @id @default(uuid()) @db.Uuid
  workspaceId          String            @map("workspace_id") @db.Uuid
  serverId             String            @map("server_id") @db.Uuid
  remoteName           String            @map("remote_name")
  runtimeId            String            @unique(map: "uq_mcp_server_tools_runtime_id") @map("runtime_id")
  title                String?
  description          String            @default("") @db.Text
  inputSchema          Json              @map("input_schema") @db.JsonB
  outputSchema         Json?             @map("output_schema") @db.JsonB
  annotations          Json?             @db.JsonB
  schemaHash           String            @map("schema_hash")
  enabled              Boolean           @default(false)
  approvalMode         McpApprovalMode?  @map("approval_mode")
  riskLevel            McpRiskLevel      @default(LOW) @map("risk_level")
  sensitiveInputPaths  Json              @default("[]") @map("sensitive_input_paths") @db.JsonB
  sensitiveOutputPaths Json              @default("[]") @map("sensitive_output_paths") @db.JsonB
  lastSeenAt           DateTime          @map("last_seen_at") @db.Timestamptz(6)
  unavailableAt        DateTime?         @map("unavailable_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  server               McpServer         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  approvals            McpToolApproval[]

  @@unique([serverId, remoteName], map: "uq_mcp_server_tools_server_remote_name")
  @@index([serverId, enabled, unavailableAt], map: "idx_mcp_server_tools_server_enabled_available")
  @@map("mcp_server_tools")
}

/// Chat Runtime 的一次性工具审批。真实参数加密保存，哈希用于防止批准后替换参数重放。
model McpToolApproval {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  serverId       String                @map("server_id") @db.Uuid
  toolId         String                @map("tool_id") @db.Uuid
  runtimeId      String                @map("runtime_id")
  runId          String                @map("run_id") @db.Uuid
  stepId         String?               @map("step_id") @db.Uuid
  toolCallId     String?               @map("tool_call_id")
  requestId      String?               @map("request_id")
  userId         String                @map("user_id") @db.Uuid
  agentId        String                @map("agent_id") @db.Uuid
  encryptedInput String                @map("encrypted_input") @db.Text
  inputHash      String                @map("input_hash")
  status         McpToolApprovalStatus @default(PENDING)
  expiresAt      DateTime              @map("expires_at") @db.Timestamptz(6)
  decidedAt      DateTime?             @map("decided_at") @db.Timestamptz(6)
  consumedAt     DateTime?             @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  server         McpServer             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tool           McpServerTool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)], map: "idx_mcp_tool_approvals_user_status_created_at")
  @@index([runId, status], map: "idx_mcp_tool_approvals_run_status")
  @@index([expiresAt, status], map: "idx_mcp_tool_approvals_expiry_status")
  @@map("mcp_tool_approvals")
}

/// 每次发现都单独记录结果；失败记录不能覆盖上一份可工作的 Tool 快照。
model McpSyncRun {
  id                 String         @id @default(uuid()) @db.Uuid
  workspaceId        String         @map("workspace_id") @db.Uuid
  serverId           String         @map("server_id") @db.Uuid
  status             McpSyncStatus  @default(RUNNING)
  trigger            McpSyncTrigger
  toolCount          Int            @default(0) @map("tool_count")
  schemaChangedCount Int            @default(0) @map("schema_changed_count")
  errorCode          String?        @map("error_code")
  errorMessage       String?        @map("error_message") @db.Text
  elapsedMs          Int?           @map("elapsed_ms")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?      @map("completed_at") @db.Timestamptz(6)
  server             McpServer      @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt(sort: Desc)], map: "idx_mcp_sync_runs_server_created_at")
  @@map("mcp_sync_runs")
}

/// 保留型 Agent 的成员私有会话。
///
/// 一个成员可以为同一个 Agent 创建多条会话；所有查询都必须同时按 user_id 和 agent_id
/// 过滤，避免仅凭 session ID 访问到其他成员的对话。
model ChatSession {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  agentId        String               @map("agent_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  title          String               @default("")
  status         ChatSessionStatus    @default(ACTIVE)
  summary        String?              @db.Text
  summaryUntilId String?              @map("summary_until_id") @db.Uuid
  lastMessageAt  DateTime?            @map("last_message_at") @db.Timestamptz(6)
  archivedAt     DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent          Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ChatSessionMessage[]

  @@index([agentId, userId, status, lastMessageAt(sort: Desc)], map: "idx_chat_sessions_agent_user_status_last_message")
  @@index([userId, status, updatedAt(sort: Desc)], map: "idx_chat_sessions_user_status_updated_at")
  @@map("chat_sessions")
}

/// 会话的可恢复文本消息。附件二进制仍由文件存储模块负责，因此这里不保存 data URL，
/// 防止一张图片把会话表无限放大；首期恢复文本和模型上下文即可。
model ChatSessionMessage {
  id        String                 @id @default(uuid()) @db.Uuid
  sessionId String                 @map("session_id") @db.Uuid
  role      ChatSessionMessageRole
  content   String                 @db.Text
  metadata  Json?                  @db.JsonB
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  session   ChatSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedbacks ChatMessageFeedback[]

  @@index([sessionId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_chat_session_messages_cursor")
  @@map("chat_session_messages")
}

/// 成员对一条已持久化 Assistant 消息的质量反馈；归属通过消息所属会话再次校验。
model ChatMessageFeedback {
  id        String                    @id @default(uuid()) @db.Uuid
  messageId String                    @map("message_id") @db.Uuid
  userId    String                    @map("user_id") @db.Uuid
  rating    ChatMessageFeedbackRating
  reason    String?                   @db.Text
  createdAt DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  message   ChatSessionMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId], map: "uq_chat_message_feedback_message_user")
  @@index([rating, createdAt(sort: Desc)], map: "idx_chat_message_feedback_rating_created_at")
  @@map("chat_message_feedbacks")
}

model ToolCallLog {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  requestId    String?  @map("request_id")
  agentId      String?  @map("agent_id")
  userId       String?  @map("user_id")
  toolCallId   String?  @map("tool_call_id")
  toolId       String?  @map("tool_id")
  status       String
  source       String?
  reason       String?
  input        Json?    @db.JsonB
  output       Json?    @db.JsonB
  errorType    String?  @map("error_type")
  errorMessage String?  @map("error_message") @db.Text
  elapsedMs    Int?     @map("elapsed_ms")
  runId        String?  @map("run_id") @db.Uuid
  stepId       String?  @map("step_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_tool_call_logs_created_at")
  @@index([requestId], map: "idx_tool_call_logs_request_id")
  @@index([agentId, createdAt(sort: Desc)], map: "idx_tool_call_logs_agent_id_created_at")
  @@index([toolId, createdAt(sort: Desc)], map: "idx_tool_call_logs_tool_id_created_at")
  @@index([status, createdAt(sort: Desc)], map: "idx_tool_call_logs_status_created_at")
  @@index([runId], map: "idx_tool_call_logs_run_id")
  @@index([stepId], map: "idx_tool_call_logs_step_id")
  @@map("tool_call_logs")
}

/// 一次 Agent 执行的顶层记录。会话 ID 只作为跨模块追踪键，不建立到会话表的 ORM 关系。
model AgentRun {
  id                     String           @id @default(uuid()) @db.Uuid
  workspaceId            String           @map("workspace_id") @db.Uuid
  requestId              String           @map("request_id")
  source                 AgentRunSource
  agentId                String?          @map("agent_id") @db.Uuid
  userId                 String?          @map("user_id") @db.Uuid
  sessionId              String?          @map("session_id") @db.Uuid
  externalConversationId String?          @map("external_conversation_id") @db.Uuid
  status                 AgentRunStatus   @default(QUEUED)
  modelConfigId          String?          @map("model_config_id") @db.Uuid
  workflowId             String?          @map("workflow_id") @db.Uuid
  workflowVersionId      String?          @map("workflow_version_id") @db.Uuid
  workflowRunMode        WorkflowRunMode? @map("workflow_run_mode")
  inputPreview           String           @map("input_preview") @db.Text
  outputPreview          String?          @map("output_preview") @db.Text
  inputTokens            Int?             @map("input_tokens")
  outputTokens           Int?             @map("output_tokens")
  estimatedCost          Decimal?         @map("estimated_cost") @db.Decimal(12, 6)
  firstTokenAt           DateTime?        @map("first_token_at") @db.Timestamptz(6)
  startedAt              DateTime?        @map("started_at") @db.Timestamptz(6)
  finishedAt             DateTime?        @map("finished_at") @db.Timestamptz(6)
  errorType              String?          @map("error_type")
  errorMessage           String?          @map("error_message") @db.Text
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  agent                  Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user                   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  steps                  AgentRunStep[]

  @@index([requestId], map: "idx_agent_runs_request_id")
  @@index([agentId, createdAt(sort: Desc)], map: "idx_agent_runs_agent_created_at")
  @@index([userId, createdAt(sort: Desc)], map: "idx_agent_runs_user_created_at")
  @@index([status, createdAt(sort: Desc)], map: "idx_agent_runs_status_created_at")
  @@index([sessionId, createdAt(sort: Desc)], map: "idx_agent_runs_session_created_at")
  @@index([externalConversationId, createdAt(sort: Desc)], map: "idx_agent_runs_external_conversation_created_at")
  @@index([workflowId, workflowVersionId, createdAt(sort: Desc)], map: "idx_agent_runs_workflow_version_created_at")
  @@map("agent_runs")
}

/// Run 内的可排序执行步骤，记录检索、模型、工具等阶段的状态和脱敏摘要。
model AgentRunStep {
  id           String             @id @default(uuid()) @db.Uuid
  runId        String             @map("run_id") @db.Uuid
  sequence     Int
  type         AgentRunStepType
  name         String
  nodeId       String?            @map("node_id")
  attempt      Int                @default(1)
  status       AgentRunStepStatus @default(RUNNING)
  input        Json?              @db.JsonB
  output       Json?              @db.JsonB
  elapsedMs    Int?               @map("elapsed_ms")
  errorType    String?            @map("error_type")
  errorMessage String?            @map("error_message") @db.Text
  startedAt    DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?          @map("finished_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  run          AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence], map: "uq_agent_run_steps_run_sequence")
  @@index([runId, sequence], map: "idx_agent_run_steps_run_sequence")
  @@index([type, startedAt(sort: Desc)], map: "idx_agent_run_steps_type_started_at")
  @@index([status, startedAt(sort: Desc)], map: "idx_agent_run_steps_status_started_at")
  @@map("agent_run_steps")
}

model KnowledgeBase {
  id                     String                   @id @default(uuid()) @db.Uuid
  workspaceId            String                   @map("workspace_id") @db.Uuid
  name                   String
  description            String                   @default("")
  embeddingModelConfigId String                   @map("embedding_model_config_id") @db.Uuid
  embeddingDimension     Int                      @default(1536) @map("embedding_dimension")
  vectorStoreType        String                   @default("PGVECTOR") @map("vector_store_type")
  vectorCollectionName   String                   @map("vector_collection_name")
  enabled                Boolean                  @default(true)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?                @map("deleted_at") @db.Timestamptz(6)
  embeddingModelConfig   ModelConfig              @relation(fields: [embeddingModelConfigId], references: [id])
  documents              KnowledgeDocument[]
  chunks                 KnowledgeChunk[]
  embeddings1024         KnowledgeEmbedding1024[]
  embeddings1536         KnowledgeEmbedding1536[]
  embeddings3072         KnowledgeEmbedding3072[]
  agentKnowledgeBases    AgentKnowledgeBase[]

  @@unique([vectorCollectionName], map: "uq_knowledge_bases_vector_collection_name")
  @@index([createdAt(sort: Desc)], map: "idx_knowledge_bases_created_at")
  @@index([embeddingDimension], map: "idx_knowledge_bases_embedding_dimension")
  @@index([embeddingModelConfigId], map: "idx_knowledge_bases_embedding_model_config_id")
  @@index([enabled, createdAt(sort: Desc)], map: "idx_knowledge_bases_enabled_created_at")
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  knowledgeBaseId  String           @map("knowledge_base_id") @db.Uuid
  filename         String
  originalFilename String           @map("original_filename")
  mimeType         String           @map("mime_type")
  fileSize         BigInt           @map("file_size")
  fileHash         String           @map("file_hash")
  storagePath      String           @map("storage_path")
  status           String
  errorMessage     String?          @map("error_message") @db.Text
  chunkCount       Int              @default(0) @map("chunk_count")
  indexedAt        DateTime?        @map("indexed_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  knowledgeBase    KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks           KnowledgeChunk[]

  @@index([knowledgeBaseId, createdAt(sort: Desc)], map: "idx_knowledge_documents_knowledge_base_id_created_at")
  @@index([knowledgeBaseId, status, createdAt(sort: Desc)], map: "idx_knowledge_documents_knowledge_base_id_status_created_at")
  @@index([fileHash], map: "idx_knowledge_documents_file_hash")
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id              String                  @id @default(uuid()) @db.Uuid
  workspaceId     String                  @map("workspace_id") @db.Uuid
  knowledgeBaseId String                  @map("knowledge_base_id") @db.Uuid
  documentId      String                  @map("document_id") @db.Uuid
  chunkIndex      Int                     @map("chunk_index")
  content         String                  @db.Text
  tokenCount      Int?                    @map("token_count")
  metadata        Json?                   @db.JsonB
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime?               @map("deleted_at") @db.Timestamptz(6)
  knowledgeBase   KnowledgeBase           @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document        KnowledgeDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding       KnowledgeEmbedding?
  embeddings1024  KnowledgeEmbedding1024?
  embeddings1536  KnowledgeEmbedding1536?
  embeddings3072  KnowledgeEmbedding3072?

  @@index([documentId, chunkIndex], map: "idx_knowledge_chunks_document_id_chunk_index")
  @@index([knowledgeBaseId, createdAt(sort: Desc)], map: "idx_knowledge_chunks_knowledge_base_id_created_at")
  @@map("knowledge_chunks")
}

model KnowledgeEmbedding {
