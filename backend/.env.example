MIA_APP_NAME=Mia
MIA_APP_VERSION=0.1.0
MIA_ENVIRONMENT=local
MIA_API_PREFIX=/api/v1
MIA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MIA_SECRET_KEY=change-me-to-a-long-random-secret
# JWT 登录签名密钥必须与 MIA_SECRET_KEY 分开配置；生产环境请使用随机长字符串。
MIA_AUTH_JWT_SECRET=change-me-to-a-different-long-random-secret
MIA_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
MIA_AUTH_REFRESH_TOKEN_TTL_DAYS=30
# 生产 HTTPS 环境必须改为 true，确保 Refresh Cookie 不会通过明文 HTTP 发送。
MIA_AUTH_COOKIE_SECURE=false
PORT=8000
DATABASE_URL=postgresql://***:***@127.0.0.1:5432/###
TOOLS_HTTP_ALLOWED_HOSTS=api.example.com,*.trusted.example.com
MIA_TOOLS_HTTP_ALLOWED_HOSTS=api.example.com,*.trusted.example.com
MIA_TOOLS_HTTP_ALLOW_LOCALHOST=false
