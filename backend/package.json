{
  "name": "mia-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Mia NestJS backend",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:evaluation-worker": "node dist/evaluation-worker.js",
    "build": "nest build",
    "test": "npm run build && node dist/test/run-tests.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "users:bootstrap-admin": "npm run build && node dist/scripts/bootstrap-admin.js",
    "agent-runs:cleanup": "npm run build && node dist/scripts/cleanup-agent-runs.js",
    "agent-versions:backfill": "npm run build && node dist/scripts/backfill-agent-versions.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "ajv": "^8.18.0",
    "argon2": "^0.45.0",
    "bullmq": "^6.3.8",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "prisma": "^6.19.0",
    "typescript": "^5.6.0"
  }
}
