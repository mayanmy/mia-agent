# 复制为 .env.docker 后再部署。deploy.sh 会在首次运行时自动创建并生成随机密钥。
MIA_HTTP_PORT=8080
MIA_WEB_BIND_ADDRESS=0.0.0.0
MIA_API_PORT=8000
# 同机分 Compose 部署需监听所有网卡；只允许本机访问时改为 127.0.0.1。
MIA_API_BIND_ADDRESS=0.0.0.0
POSTGRES_DB=mia
POSTGRES_USER=mia
POSTGRES_PASSWORD=change-me-to-a-random-database-password
MIA_SECRET_KEY=change-me-to-a-long-random-secret
MIA_AUTH_JWT_SECRET=change-me-to-a-different-long-random-secret
MIA_REDIS_PREFIX=mia:production
MIA_REDIS_REQUIRED=true
MIA_LLM_DISTRIBUTED_CONCURRENCY_ENABLED=true
# 建议使用独立随机值；留空时后端回退到 JWT secret。
MIA_RATE_LIMIT_HASH_SECRET=

# 浏览器访问 Mia 的完整地址。使用 HTTPS 域名时，同时将 Cookie Secure 改为 true。
MIA_PUBLIC_BASE_URL=http://localhost:8080
MIA_CORS_ORIGINS=http://localhost:8080
MIA_AUTH_COOKIE_SECURE=false

# 前端 Nginx 代理的后端地址。跨服务器部署时改为后端内网地址或 HTTPS 域名。
MIA_API_UPSTREAM=http://host.docker.internal:8000

# HTTP 工具允许访问的目标，逗号分隔；默认不允许访问本机或容器内网地址。
TOOLS_HTTP_ALLOWED_HOSTS=
MIA_TOOLS_HTTP_ALLOW_LOCALHOST=false
